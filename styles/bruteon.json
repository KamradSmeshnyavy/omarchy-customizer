    "dashAttach": "floating",
    "dashBackground": "background",
    "dashAlpha": 1,
    "dashRadius": 10,
    "dashBorder": true,
    "dashAnimation": "fade",
    "dashDuration": 250,
    "home": false,
    "deck": false,
    "homeLayout": "auto",
    "homeCards": "auto",
    "homeHideWidgets": true,
    "deckLayout": "auto",
    "deckCards": "auto",
