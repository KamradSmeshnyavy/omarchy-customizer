{
  "name": "Bruteon",
  "name_ru": "Bruteon",
  "note": "After Bruteon by Darkkal44 (neo-brutalism, look from its screenshots): warm cream paper, everything outlined in thick dark ink with a hard shadow without blur, pastel tiles — three islands of a bar, a dashboard of cards, windows with a 3 px border and a 6 × 6 hard shadow, springy pop-ins, JetBrains Mono.",
  "note_ru": "По мотивам Bruteon (Darkkal44, необрутализм, облик с его скриншотов): тёплая кремовая бумага, всё обведено толстым тёмным контуром с жёсткой тенью без размытия, пастельные плитки — три острова бара, дашборд из карточек, окна с рамкой 3 px и жёсткой тенью 6 × 6, упругие появления, JetBrains Mono.",
  "anims": "bruteon",
  "opacity": "solid",
  "blur": "off",
  "shader": "off",
  "hyprGeometry": {
    "gapsIn": 8,
    "gapsOut": 18,
    "borderSize": 3,
    "rounding": 10,
    "shadow": true,
    "noGaps": false
  },
  "barSkin": "bruteon",
  "barLayout": "bruteon",
  "barTransparent": false,
  "lock": {
    "design": "style-brutal",
    "wallpaperBlur": 0,
    "wallpaperDim": 0.35
  },
  "launcher": {
    "skin": "drawer-brutal",
    "backdrop": 0.75
  },
  "wallpaperFx": {
